.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.superpowers/
.worktrees/

# Local credentials, private keys, and machine-only logs.
.env
.env.*
!.env.example
secrets/
.secrets/
credentials/
.credentials/
*.pem
*.key
*.p12
*.pfx
*.log

models/
council/

# Session artifacts and generated reports.
data/sessions/
data/calibration/
data/comparisons/
data/voice/
data/*.json
data/*.html
data/*.txt
# Adjudication queues quote real interview answers verbatim.
data/*.md

# ---------------------------------------------------------------- not published
# Private working documents. They stay on disk and out of the repository: the plan
# and the research log carry the measurements and the reasoning behind every rule
# here, and internal_docs/ holds three model reviews of this codebase.
MOCKINGBIRD_PLAN.md
RESEARCH_AND_EXPERIMENTS_LOG.md
REVIEW_TAKEAWAYS_IMPROVEMENT_PLAN.md
internal_docs/

# Research harnesses. Tier 1 and Tier 2 measured the model, the prompts and the
# rubric before any of it shipped; they are instruments rather than product, and
# several embed fixture answers and findings from the log above.
tools/README.md
tools/tier1_*.py
tools/tier2_*.py
tools/stage0*.py
tools/stage0*.json
tools/stage1_*.py
tools/stage2_*.py
!tools/stage2_report.py
tools/analyse_*.py
tools/analysis*.json
tools/model_bench.*
tools/deciders.py
tools/depth_signals.py
tools/fixtures_v2.py
tools/fixtures_build.py
tools/samples.json
tools/session_long.py
tools/session_script.py
tools/calibrate.py
tools/audition.html
tools/spike_*.py
tools/tier1_posterior_granite.json

# Recorded speech, anywhere in the tree. A local-first product must not push a candidate's
# voice to a public repo, and the one thing worse than losing an answer is publishing it.
*.wav
*.mp3
*.webm
*.ogg

# Agent working notes for an abandoned Exaone/Granite adaptation on a dead branch. Internal
# process rather than project documentation, and it carried an absolute home path.
docs/superpowers/

# Stage 4's UI. The source and the self-hosted fonts are tracked (the app must render
# offline, so the faces cannot come from a CDN); the install and the build are not.
ui/node_modules/
ui/build/
ui/.svelte-kit/

# Design review working files: screenshots and scratch captures, regenerated by tools/shots.sh.
.impeccable/

# Local launchers. They hardcode this machine's virtualenv path, port and model identifier, so
# they would be wrong on anyone else's and are not the documented way in -- README's is.
# Only the launch config here, not all of .claude/: project settings are worth tracking.
run.bat
stop.bat
.claude/launch.json
